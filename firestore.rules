rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for readability and reuse
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string 
        && id.size() <= 128 
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && isUserOwner(userId);

      // Rules matching user-isolated mindmaps
      match /mindmaps/{mindmapId} {
        
        // Read & write access: Fully authorized if user owns the parent path segment
        allow read, write: if isSignedIn()
          && isUserOwner(userId)
          && isValidId(mindmapId);
      }
    }
  }
}
